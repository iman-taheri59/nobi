# /etc/sudoers.d/nobi-status — read-only reporting for the GitHub "Status" workflow.
# Install:  sudo install -m 440 deploy/nobi-status.sudoers /etc/sudoers.d/nobi-status && sudo visudo -cf /etc/sudoers.d/nobi-status
# Every command here only reads: journal tail, ls/du of the data directory, and the
# analysis scripts run as the service user (they open journal.db read-only and
# never write paper_state.json). No restart, no update, no shell.
#
# Ubuntu 26.04+ ships sudo-rs, whose parser refuses wildcards in command
# arguments ("wildcards are not allowed in command arguments", seen live on
# 2026-11-24). A glob anywhere in this file makes `visudo -cf` reject the WHOLE
# file and none of these rules becomes available — which is why the previously
# used `journalctl -u nobi -n [0-9]*` and `script.py *` rules silently granted
# nothing (every Status-run sudo call was refused until this was pinned).
#
# So every rule below is an EXACT argv, and the variable time windows
# (--last-hours 24 / --last-days 17) are baked into the scripts as flags. Change
# them in both places together: the workflow (.github/workflows/status.yml) and
# these pins. test_status_sudoers.py holds the line.
deploy ALL=(root) NOPASSWD: /usr/bin/journalctl -u nobi -n 2000 --no-pager -o short-iso
deploy ALL=(root) NOPASSWD: /usr/bin/journalctl -u nobi -n 200 --no-pager -o short-iso
deploy ALL=(root) NOPASSWD: /usr/bin/journalctl -u nobi -n 200 --no-pager
deploy ALL=(nobi) NOPASSWD: /usr/bin/ls -lt /srv/nobi-data/ /srv/nobi-data/backup/
deploy ALL=(nobi) NOPASSWD: /usr/bin/ls -l /srv/nobi-data/ /srv/nobi-data/backup/
deploy ALL=(nobi) NOPASSWD: /usr/bin/du -sh /srv/nobi-data
deploy ALL=(nobi) NOPASSWD: /opt/nobi/.venv/bin/python /opt/nobi/scripts/journal_diagnostic.py /srv/nobi-data/journal.db --last-hours 24 --paper /srv/nobi-data/paper_state.json
deploy ALL=(nobi) NOPASSWD: /opt/nobi/.venv/bin/python /opt/nobi/scripts/paper_state_summary.py /srv/nobi-data/paper_state.json --events 20
deploy ALL=(nobi) NOPASSWD: /opt/nobi/.venv/bin/python /opt/nobi/scripts/journal_holdout.py show --db /srv/nobi-data/journal.db
deploy ALL=(nobi) NOPASSWD: /opt/nobi/.venv/bin/python /opt/nobi/scripts/shadow_backfill.py /srv/nobi-data/journal.db --last-days 17 --paper /srv/nobi-data/paper_state.json
deploy ALL=(nobi) NOPASSWD: /opt/nobi/.venv/bin/python /opt/nobi/scripts/pump_chase_backfill.py /srv/nobi-data/journal.db --last-days 17
