#!/usr/bin/env python3
"""Unprivileged client for the socket-activated installer helper.

Runs inside the hardened web process. No sudo, no setuid, no shell. It keeps
the exact ``--protocol N <action>`` argv the web app already emits, so the
application-side contract (and its tests) does not change.
"""
from __future__ import annotations

import json
import os
import socket
import sys

DEFAULT_SOCKET = "/run/nobi-installer.sock"
PROTOCOL = 1
ACTIONS = frozenset({
    "install-service", "install-proxy", "restart-service", "reload-proxy",
    "rollback", "check",
})


def main() -> int:
    args = sys.argv[1:]
    path = os.getenv("NBX_HELPER_SOCKET", DEFAULT_SOCKET)
    if len(args) == 4 and args[0] == "--socket":
        path, args = args[1], args[2:]
    if len(args) != 3 or args[0] != "--protocol" or args[1] != str(PROTOCOL) \
            or args[2] not in ACTIONS:
        print(json.dumps({"ok": False, "error": "expected --protocol 1 <allowlisted action>"}))
        return 2
    request = json.dumps({"protocol": PROTOCOL, "action": args[2]},
                         separators=(",", ":")) + "\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(110)
            sock.connect(path)
            sock.sendall(request.encode("utf-8"))
            chunks = bytearray()
            while len(chunks) < 8192:
                part = sock.recv(4096)
                if not part:
                    break
                chunks.extend(part)
                if b"\n" in part:
                    break
    except OSError as exc:
        print(json.dumps({"ok": False, "error": f"helper socket unavailable: {exc}"}))
        return 1
    try:
        reply = json.loads(bytes(chunks).decode("utf-8").strip())
    except (UnicodeDecodeError, json.JSONDecodeError):
        print(json.dumps({"ok": False, "error": "malformed helper reply"}))
        return 1
    print(json.dumps(reply))
    return 0 if reply.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main())
