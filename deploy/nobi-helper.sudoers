# Install as /etc/sudoers.d/nobi-helper, root:root 0440; validate with visudo -cf.
# Exact argv only: no wildcard, shell, arbitrary package, service, or path.
Cmnd_Alias NOBI_HELPER = /usr/local/libexec/nobi-privileged-helper --protocol 1 install-service, \
 /usr/local/libexec/nobi-privileged-helper --protocol 1 install-proxy, \
 /usr/local/libexec/nobi-privileged-helper --protocol 1 restart-service, \
 /usr/local/libexec/nobi-privileged-helper --protocol 1 reload-proxy, \
 /usr/local/libexec/nobi-privileged-helper --protocol 1 rollback
nobi ALL=(root) NOPASSWD: NOBI_HELPER
