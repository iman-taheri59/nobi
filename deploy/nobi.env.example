# /etc/nobi/nobi.env — environment for the nobi service (mode 600, owner nobi)
#
# systemd reads this file, and systemd's environment *outranks* server/.env.
# Keep secrets here, not in the checkout: `git clean -xdf` must never be able
# to delete the only copy of your token.
#
# After every change:  sudo systemctl restart nobi
# Then verify:         sudo -u nobi /opt/nobi/.venv/bin/python /opt/nobi/scripts/check_deploy.py --public https://YOUR.DOMAIN

# --- required behind a proxy ------------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The app refuses to start if NBX_TRUSTED_PROXIES is set and this is empty.
NBX_API_TOKEN=REPLACE_WITH_32_RANDOM_BYTES

# nginx connects from 127.0.0.1. Without this line the app cannot tell a
# proxied request from a local one and closes the door on everybody — which is
# safe, and useless. With it, X-Forwarded-For is trusted only from here.
NBX_TRUSTED_PROXIES=127.0.0.1

# --- data ------------------------------------------------------------------
# Anything not on a mounted volume disappears when the ابرک is rebuilt.
NBX_JOURNAL_DB=/srv/nobi-data/journal.db
NBX_PAPER_STATE=/srv/nobi-data/paper_state.json
# Accounts (usernames, scrypt hashes, sessions). Losing this file locks
# everybody out; keeping it inside the checkout means the service cannot write
# to it at all (ProtectSystem=strict), so it lives on the volume.
NBX_AUTH_DB=/srv/nobi-data/auth.db
NBX_EXPORT_DIR=/srv/nobi-data/exports

# --- market ----------------------------------------------------------------
NBX_BASE_URL=https://apiv2.nobitex.ir
NBX_EQUITY_USD=100000
# Mutations per minute per client+path. The default (60) is fine for one user;
# lower it if the URL is public.
NBX_RATE_LIMIT=60
# Same-origin only: the dashboard is served by this very app. Add "null" if you
# also open the standalone file:// copy against this server.
NBX_CORS_ORIGINS=

# --- optional --------------------------------------------------------------
# Sign-in attempts allowed per address per minute, counted across usernames.
# Raise it when several people share one office/carrier address.
# NBX_LOGIN_RATE_LIMIT=20
# Rebuild the inlined dashboard once at startup instead of at deploy time. Off
# by default: a request must never wait for `npm`.
# NBX_AUTOBUILD_PAGE=0
# Telegram alerts stay off until both are set (ADR-0011).
# NBX_TELEGRAM_TOKEN=
# NBX_TELEGRAM_CHAT_ID=
# 0 disables the daily CSV digest.
# NBX_DIGEST_HOURS=24
# Real trading needs the signed key pair (ADR-0009). Paper trading does not.
# NOBITEX_API_KEY=
# NOBITEX_API_SECRET=

# Display cache: primary Nobitex options + supplemental CoinGecko logos.
# NBX_COIN_METADATA_ENABLED controls CoinGecko only, not exchange options.
# Demo API key only; never put it in the browser. Public access is attempted
# without a key, but may be rate-limited/refused by the provider.
NBX_COIN_CACHE=/srv/nobi-data/coin-cache
# The candle cache is data, not code. Pointing it at the checkout was a startup
# failure under ProtectSystem=strict (the mkdir ran at import time), so it lives
# on the volume like everything else the service writes.
NBX_CANDLE_CACHE=/srv/nobi-data/candle-cache
# Same argument for walk-forward reports: they are output, not source.
NBX_BT_DIR=/srv/nobi-data/backtest-reports
NBX_COIN_METADATA_ENABLED=1
# NBX_COINGECKO_API_KEY=
