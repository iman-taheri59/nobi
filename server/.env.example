# Copy → .env and customize. Never commit .env.
NBX_BASE_URL=https://apiv2.nobitex.ir
NBX_EQUITY_USD=100000

# ---- Access control (see security.py) --------------------------------
# Shared secret for state-changing endpoints (paper orders, halt, backtests).
# When empty, mutations are accepted from loopback only — fine for local use,
# refused for anything remote.
# NBX_API_TOKEN=change-me
# Comma-separated origin allow-list. Empty = same-origin only (recommended,
# the dashboard is served by this very app). Use "null" to also permit the
# standalone mobile file (file://).
# NBX_CORS_ORIGINS=https://desk.example.com,null
# Mutations per minute per client+path.
# NBX_RATE_LIMIT=60

# ---- Market data / streaming ----------------------------------------
# Background stop-loss/take-profit evaluation cadence (seconds).
# NBX_TICK_S=8
# REST orderbook polling cadence used by the paper broker (seconds).
# NBX_STREAM_POLL_S=5
# Opt-in real WebSocket (Centrifugo). Leave empty to stay on REST polling.
# NBX_WS_URL=wss://ws.nobitex.ir/connection/websocket
# NBX_WS_CHANNEL_PREFIX=market:

# ---- Notifications (ADR-0011 §2.2) ----------------------------------
# Both must be set or the channel stays off; the UI then says
# "Telegram: not configured" instead of pretending a message went out.
# NBX_TELEGRAM_TOKEN=123456:ABC...
# NBX_TELEGRAM_CHAT_ID=-1001234567890
# NBX_TELEGRAM_BACKOFF_S=300

# ---- Scheduled export / digest (ADR-0012 §2.6) ----------------------
# 0 disables the timer. Files land in NBX_EXPORT_DIR as CSV (+ JSON via API).
# NBX_DIGEST_HOURS=24
# NBX_EXPORT_DIR=./exports

# ---- Scheduled scan (ADR-0024) ---------------------------------------
# How often the server scans *by itself*, in seconds. 0 (the default) = never:
# after startup a scan happens only when something asks for one, and in practice
# that something is an open dashboard tab. While that is the only trigger, the
# shadow ledger's `days` count (ADR-0022/0023) depends on a browser being left
# open — set this to 900 and the process fills the evidence window on its own.
#   floor 60 s; a smaller value is refused (one error in the log, loop stays off)
#   it never changes a score: the scan is the same function /api/signals runs
# NBX_SCAN_LOOP_S=900
# Timeframe the scheduled scan judges. Default 15m.
# NBX_SCAN_LOOP_TF=15m
#
# ---- Order-book inputs for the gate (ADR-0023 S1) ---------------------
# How many of the top symbols get their book read on every scan. Ceiling is 20
# (a rate budget, not a preference): a larger value raises and the prefetch stops
# entirely, which reads as "books: 0" rather than as an error.
# NBX_GATE_PREFETCH=20
# A book younger than this is reused; a book older than NBX_BOOK_GATE_TTL_S can
# no longer judge a bar and is counted as `stale_books`. Keep the first smaller
# than the second or every book expires before the next scan can use it.
# NBX_BOOK_TTL_S=120
# NBX_BOOK_GATE_TTL_S=300
# NBX_BOOK_KEEP_S=3600

# ---- Cache / freshness ----------------------------------------------
# Where Parquet candles go. Default: ./candle_cache next to the code, which is
# fine for a laptop and wrong for a service that runs with a read-only checkout.
# NBX_CANDLE_CACHE=./candle_cache
# NBX_BT_DIR=./server/backtest_reports
# Sign-in attempts per address per minute (across usernames).
# NBX_LOGIN_RATE_LIMIT=20
# NBX_SIGNALS_TTL_S=90
# NBX_UNIVERSE_TTL_S=120
# NBX_UPSTREAM_TTL_S=20

# ---- Live control plane (ADR-0028..0031; placement route is absent) ---
# Default disabled. `live` additionally requires the exact confirmation phrase,
# both API credentials and an IP-limited READ/TRADE key. Never commit values.
# NBX_LIVE_MODE=disabled
# NBX_LIVE_CONFIRM=I-UNDERSTAND-THIS-PLACES-REAL-ORDERS
# NBX_LIVE_DB=./server/live_execution.db
# NOBITEX_API_KEY=
# NOBITEX_API_SECRET=

# ---- Risk policy (ADR-0008) -------------------------------------------
# Take-profit ladder as multiples of the stop distance: tp1,tp2 (two or more,
# rising). The live default is 1.2,2.0; the backtester searches its own grid.
# Copy the winner here deliberately — never automatically (ADR-0008 amendment).
# NBX_RR_LEVELS=1.2,2.0

# ---- Owner wizard / operations state (must be on the writable volume) -------
# Defaults live in server/, which ProtectSystem=strict makes read-only.
# NBX_MANAGED_ENV=/srv/nobi-data/managed.env
# NBX_OPERATIONS_AUDIT=/srv/nobi-data/operations-audit.jsonl
# NBX_SETUP_TOKEN_FILE=/srv/nobi-data/setup.token
# NBX_LIVE_DB=/srv/nobi-data/live_execution.db
# Socket-activated root helper client for the browser installer (no sudo).
# NBX_INSTALL_HELPER=/usr/local/bin/nobi-helper-client
